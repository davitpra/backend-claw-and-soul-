# Database (PostgreSQL)
DATABASE_URL="postgresql://clawandsoul:your_secure_password@localhost:5432/clawandsoul_dev"

# Redis Configuration
# Si REDIS_URL está definida manda ella y las variables sueltas se ignoran.
# En producción los proveedores gestionados dan un rediss:// (TLS obligatorio).
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_ACCESS_SECRET="your-access-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-key-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Configuration
# Orígenes permitidos por CORS. Admite varios separados por comas, con esquema y
# sin barra final:
#   FRONTEND_URL="https://clawandsoul.com,https://staging.clawandsoul.com"
# Solo sirve para hosts bajo el mismo dominio raíz que COOKIE_DOMAIN; desde
# fuera el CORS pasaría pero la cookie sameSite=lax no viajaría.
FRONTEND_URL="http://localhost:3000"

# Cookies de sesión.
# COOKIE_DOMAIN: déjalo vacío en local. En producción, con la API en
# api.clawandsoul.com y el frontend en clawandsoul.com, ponlo a ".clawandsoul.com"
# para que la cookie viaje a ambos.
COOKIE_DOMAIN=""
# Solo si frontend y API acaban en dominios raíz distintos: "none" (exige HTTPS).
COOKIE_SAMESITE="lax"

# Google OAuth (same Client ID used by the frontend; client secret not needed for the ID-token flow)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Providers
FAL_KEY="fal-..."
# Optional: override the default VLM used by openrouter/router/vision (default: google/gemini-2.5-flash)
# OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-flash"
# Skip fal.ai + OpenRouter calls during local testing — returns the pet photo as the "generated" image.
MOCK_AI=true

# Webhook Security
WEBHOOK_SECRET="generate-a-strong-random-secret-here"

# Application
PORT=3001
NODE_ENV="development"
# Swagger en /api/docs. Por defecto: encendido fuera de producción, apagado en
# producción (publica toda la superficie de la API sin credenciales).
# SWAGGER_ENABLED="false"

# Account lifecycle (AccountLifecycleService)
# Desactivado por defecto: con datos de desarrollo antiguos, el barrido daría de
# baja cuentas por sorpresa. Ponlo a "true" solo en producción.
ACCOUNT_LIFECYCLE_ENABLED="false"
# Meses sin iniciar sesión ni abrir sesión nueva antes de pasar a "inactive".
# La cuenta se reactiva sola en cuanto el usuario vuelve a entrar.
INACTIVITY_MONTHS="24"

# Shopify Admin API (for product synchronization)
SHOPIFY_ADMIN_API_URL="https://clawandsoul.myshopify.com/admin/api/2024-01"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxx"
SHOPIFY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
APP_PUBLIC_URL="https://api.clawandsoul.com"
