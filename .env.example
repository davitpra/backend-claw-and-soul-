# Database (PostgreSQL)
DATABASE_URL="postgresql://clawandsoul:your_secure_password@localhost:5432/clawandsoul_dev"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_ACCESS_SECRET="your-access-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-key-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"

# Google OAuth (same Client ID used by the frontend; client secret not needed for the ID-token flow)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Providers
FAL_KEY="fal-..."
# Optional: override the default VLM used by openrouter/router/vision (default: google/gemini-2.5-flash)
# OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-flash"
# Skip fal.ai + OpenRouter calls during local testing — returns the pet photo as the "generated" image.
MOCK_AI=true

# Webhook Security
WEBHOOK_SECRET="generate-a-strong-random-secret-here"

# Application
PORT=3001
NODE_ENV="development"

# Shopify Admin API (for product synchronization)
SHOPIFY_ADMIN_API_URL="https://clawandsoul.myshopify.com/admin/api/2024-01"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxx"
SHOPIFY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
APP_PUBLIC_URL="https://api.clawandsoul.com"

# Orders & Fulfillment
ORDERS_POD_ENABLED="true"
ORDERS_SYNC_BACKFILL_DAYS="30"
# Default POD provider when a variant has no podProvider set (fallback for retrocompat)
ORDERS_DEFAULT_POD_PROVIDER="pictorem"

# Pictorem Print-on-Demand API (ArtFlow 0.1)
# Create a PRO account at https://www.pictorem.com/newaccount.html
# then generate a token at https://www.pictorem.com/myaccountapikey.html
PICTOREM_API_KEY="your-pictorem-api-key-here"
# Optional: override the default Pictorem base URL
# PICTOREM_API_URL="https://www.pictorem.com/artflow/0.1"

# Future POD providers — add credentials here following the same pattern:
# PRINTFUL_API_KEY="your-printful-api-key"
# PRINTIFY_API_KEY="your-printify-api-key"
