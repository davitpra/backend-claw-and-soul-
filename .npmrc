# Railway inyecta NODE_ENV=production también durante el build, y con eso npm
# omite las devDependencies: sin @nestjs/cli ni typescript no hay `nest build`,
# y sin el CLI de prisma fallan el postinstall y `migrate:deploy`.
# El build y el runtime comparten imagen, así que las devDeps sobran en runtime
# pero no molestan.
include=dev

# Anula un `legacy-peer-deps=true` en el ~/.npmrc de quien desarrolle. Con esa
# opción npm no instala los peers automáticos (react, vía el CLI de prisma) ni
# valida los conflictos, así que el lockfile sale distinto del que espera el
# `npm ci` del deploy: el build fallaba con EUSAGE por peers ausentes del lock.
# Con esto, un conflicto de peers se ve al instalar en local y no en Railway.
legacy-peer-deps=false
