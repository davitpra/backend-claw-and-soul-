# Railway inyecta NODE_ENV=production también durante el build, y con eso npm
# omite las devDependencies: sin @nestjs/cli ni typescript no hay `nest build`,
# y sin el CLI de prisma fallan el postinstall y `migrate:deploy`.
# El build y el runtime comparten imagen, así que las devDeps sobran en runtime
# pero no molestan.
include=dev
