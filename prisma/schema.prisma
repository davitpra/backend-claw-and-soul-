generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String?   @map("full_name")
  role          String    @default("user") // Enum: user, premium, admin
  emailVerified Boolean   @default(false) @map("email_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  pets          Pet[]
  generations   Generation[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  orders        Order[]
  expenses      Expense[]
  cart          Cart?

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// SHOPPING CART
// ============================================

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid())
  cartId       String   @map("cart_id")
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String   @map("variant_id")
  name         String
  size         String?
  style        String?
  color        String?
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  img          String
  generationId String?  @map("generation_id")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([cartId])
  @@map("cart_items")
}

// ============================================
// PETS & PET PHOTOS
// ============================================

model Pet {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  species     String // Enum: dog, cat, bird, rabbit, other
  breed       String?
  age         Int?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      PetPhoto[]
  generations Generation[]

  @@index([userId])
  @@index([species])
  @@index([userId, isActive])
  @@map("pets")
}

model PetPhoto {
  id              String   @id @default(uuid())
  petId           String   @map("pet_id")
  photoUrl        String   @map("photo_url")
  photoStorageKey String   @map("photo_storage_key")
  isPrimary       Boolean  @default(false) @map("is_primary")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")

  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([petId])
  @@index([petId, isPrimary])
  @@index([petId, orderIndex])
  @@map("pet_photos")
}

// ============================================
// VISION & IMAGE GENERATION CONFIGS
// ============================================

model VisionConfig {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?  @db.Text

  visionModel       String?  @map("vision_model")
  visionTemperature Float?   @map("vision_temperature")
  systemPrompt      String?  @map("system_prompt") @db.Text
  maxTokens         Int?     @map("max_tokens")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  styles Style[]

  @@index([isActive])
  @@map("vision_configs")
}

model ImageGenConfig {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text

  model      String? // e.g. "fal-ai/flux/dev"
  parameters Json?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  styles Style[]

  @@index([isActive])
  @@map("image_gen_configs")
}

// ============================================
// STYLES & STYLE IMAGES
// ============================================

model Style {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  category    String
  thanksUrl                String? @map("thanks_url")
  styleReferenceUrl        String? @map("style_reference_url")
  styleReferenceStorageKey String? @map("style_reference_storage_key")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Pipeline config
  strategyKey          String  @default("default") @map("strategy_key")
  promptTemplate       String  @map("prompt_template") @db.Text
  templateVars         Json?   @map("template_vars")
  templateVarOptions   Json?   @map("template_var_options")
  visionConfigId       String? @map("vision_config_id")
  imageGenConfigId     String? @map("image_gen_config_id")

  visionConfig   VisionConfig?   @relation(fields: [visionConfigId], references: [id], onDelete: SetNull)
  imageGenConfig ImageGenConfig? @relation(fields: [imageGenConfigId], references: [id], onDelete: SetNull)

  generations       Generation[]
  images            StyleImage[]
  productReferences ProductReference[]

  @@index([category])
  @@index([isActive])
  @@index([category, isActive])
  @@index([visionConfigId])
  @@index([imageGenConfigId])
  @@map("styles")
}

model StyleImage {
  id         String   @id @default(uuid())
  styleId    String   @map("style_id")
  imageUrl   String   @map("image_url")
  storageKey String   @map("storage_key")
  altImage   String?  @map("alt_image")
  orderIndex Int      @map("order_index")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
  @@index([styleId, orderIndex])
  @@index([styleId, isPrimary])
  @@map("style_images")
}

// ============================================
// FORMATS & PRODUCT REFERENCES
// ============================================

model Format {
  id                   String   @id @default(uuid())
  name                 String   @unique
  displayName          String   @map("display_name")
  aspectRatio          String   @map("aspect_ratio")
  width                Int
  height               Int
  shopifyVariantOption String?  @map("shopify_variant_option")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  generations     Generation[]
  productVariants ProductFormatVariant[]

  @@index([isActive])
  @@map("formats")
}

model ProductReference {
  id               String   @id @default(uuid())
  shopifyProductId String   @unique @map("shopify_product_id")
  shopifyHandle    String?  @map("shopify_handle")
  name             String
  displayName      String   @map("display_name")
  description      String?
  styleId          String?  @map("style_id")
  productType      String?  @map("product_type")
  isActive          Boolean  @default(true) @map("is_active")
  fulfillmentMethod String   @default("in_house") @map("fulfillment_method") // in_house | pod
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  style           Style?       @relation(fields: [styleId], references: [id], onDelete: SetNull)
  generations     Generation[]
  productVariants ProductFormatVariant[]
  orderItems      OrderItem[]

  @@index([isActive])
  @@index([styleId])
  @@index([productType])
  @@map("product_references")
}

model ProductFormatVariant {
  id                  String   @id @default(uuid())
  productRefId        String   @map("product_ref_id")
  formatId            String   @map("format_id")
  shopifyVariantId    String   @map("shopify_variant_id")
  shopifyVariantTitle String   @map("shopify_variant_title")
  constraints         Json?
  podConfig           Json?    @map("pod_config")
  podProvider         String?  @map("pod_provider") // e.g. "pictorem" — selects the provider for this variant
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  productRef ProductReference @relation(fields: [productRefId], references: [id], onDelete: Cascade)
  format     Format           @relation(fields: [formatId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productRefId, shopifyVariantId])
  @@index([shopifyVariantId])
  @@map("product_format_variants")
}

// ============================================
// GENERATIONS
// ============================================

model Generation {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  petId                 String?   @map("pet_id")
  petPhotoId            String?   @map("pet_photo_id")
  styleId               String    @map("style_id")
  formatId              String?   @map("format_id")
  productRefId          String?   @map("product_ref_id")
  type                  String // Enum: image, video
  status                String    @default("pending") // Enum: pending, processing, completed, failed
  prompt                String
  negativePrompt        String?   @map("negative_prompt")
  resultUrl             String?   @map("result_url")
  resultStorageKey      String?   @map("result_storage_key")
  thumbnailUrl          String?   @map("thumbnail_url")
  provider              String
  processingTimeSeconds Int?      @map("processing_time_seconds")
  errorMessage          String?   @map("error_message")
  metadata              Json?
  visionAnalysis        Json?     @map("vision_analysis")
  finalPrompt           String?   @map("final_prompt") @db.Text
  falRequestId          String?   @map("fal_request_id")
  promptSnapshot        Json?     @map("prompt_snapshot")
  isPublic              Boolean   @default(false) @map("is_public")
  isFavorite            Boolean   @default(false) @map("is_favorite")
  isAdminTest           Boolean   @default(false) @map("is_admin_test")
  createdAt             DateTime  @default(now()) @map("created_at")
  completedAt           DateTime? @map("completed_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet        Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)
  petPhoto   PetPhoto?         @relation(fields: [petPhotoId], references: [id], onDelete: SetNull)
  style      Style             @relation(fields: [styleId], references: [id], onDelete: Restrict)
  format     Format?           @relation(fields: [formatId], references: [id], onDelete: SetNull)
  productRef ProductReference? @relation(fields: [productRefId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  expenses   Expense[]

  @@index([userId])
  @@index([petId])
  @@index([petPhotoId])
  @@index([status])
  @@index([type])
  @@index([userId, status])
  @@index([userId, type])
  @@index([createdAt(sort: Desc)])
  @@index([styleId, isAdminTest])
  @@map("generations")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id                String    @id @default(uuid())
  shopifyOrderId    String    @unique @map("shopify_order_id")
  shopifyOrderGid   String?   @map("shopify_order_gid")
  orderNumber       String    @map("order_number")
  userId            String?   @map("user_id")
  customerEmail     String?   @map("customer_email")
  customerName      String?   @map("customer_name")
  customerPhone     String?   @map("customer_phone")
  financialStatus   String?   @map("financial_status") // paid | refunded | pending | voided
  fulfillmentStatus String?   @map("fulfillment_status") // unfulfilled | partial | fulfilled
  currency          String    @default("USD")
  subtotalAmount    Decimal   @map("subtotal_amount") @db.Decimal(10, 2)
  shippingAmount    Decimal?  @map("shipping_amount") @db.Decimal(10, 2)
  taxAmount         Decimal?  @map("tax_amount") @db.Decimal(10, 2)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(10, 2)
  shippingAddress   Json?     @map("shipping_address")
  billingAddress    Json?     @map("billing_address")
  customerNote      String?   @map("customer_note")
  shopifyCreatedAt  DateTime  @map("shopify_created_at")
  shopifyUpdatedAt  DateTime? @map("shopify_updated_at")
  cancelledAt       DateTime? @map("cancelled_at")
  productionCost    Decimal?  @map("production_cost") @db.Decimal(10, 2)
  rawPayload        Json      @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  expenses Expense[]

  @@index([userId])
  @@index([customerEmail])
  @@index([shopifyCreatedAt(sort: Desc)])
  @@index([financialStatus])
  @@map("orders")
}

model OrderItem {
  id                     String    @id @default(uuid())
  orderId                String    @map("order_id")
  shopifyLineItemId      String    @map("shopify_line_item_id")
  shopifyVariantId       String?   @map("shopify_variant_id")
  shopifyProductId       String?   @map("shopify_product_id")
  productRefId           String?   @map("product_ref_id")
  productFormatVariantId String?   @map("product_format_variant_id")
  generationId           String?   @map("generation_id")
  title                  String
  variantTitle           String?   @map("variant_title")
  sku                    String?
  quantity               Int
  unitPrice              Decimal   @map("unit_price") @db.Decimal(10, 2)
  totalPrice             Decimal   @map("total_price") @db.Decimal(10, 2)
  imageUrl               String?   @map("image_url")
  printImageUrl          String?   @map("print_image_url")
  printImageStorageKey   String?   @map("print_image_storage_key")
  // Admin-provided source art (manual upload) used as the enhancement input.
  // Kept separate from printImageUrl so enhancing never destroys the original.
  printSourceUrl         String?   @map("print_source_url")
  printSourceStorageKey  String?   @map("print_source_storage_key")
  // Raw AI-upscaled base (no colour/bleed adjustments). Lets "Guardar" re-apply
  // adjustments without re-running fal.ai and without resolution loss.
  printUpscaledUrl        String?   @map("print_upscaled_url")
  printUpscaledStorageKey String?   @map("print_upscaled_storage_key")
  style                  String?
  size                   String?
  fulfillmentMethod      String    @default("in_house") @map("fulfillment_method") // in_house | pod
  productionStatus       String    @default("paid") @map("production_status") // paid | in_production | shipped | delivered | cancelled | refunded
  trackingNumber         String?   @map("tracking_number")
  trackingUrl            String?   @map("tracking_url")
  trackingCarrier        String?   @map("tracking_carrier")
  podProvider            String?   @map("pod_provider")
  podOrderId             String?   @map("pod_order_id")
  podRawResponse         Json?     @map("pod_raw_response")
  podLeadTimeDays        Int?      @map("pod_lead_time_days")
  podEstimatedReadyAt    DateTime? @map("pod_estimated_ready_at")
  notes                  String?
  shippedAt              DateTime? @map("shipped_at")
  deliveredAt            DateTime? @map("delivered_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productRef     ProductReference?      @relation(fields: [productRefId], references: [id], onDelete: SetNull)
  productVariant ProductFormatVariant?  @relation(fields: [productFormatVariantId], references: [id], onDelete: SetNull)
  generation     Generation?            @relation(fields: [generationId], references: [id], onDelete: SetNull)
  events         OrderEvent[]
  expenses       Expense[]

  @@unique([orderId, shopifyLineItemId])
  @@index([generationId])
  @@index([productionStatus])
  @@index([fulfillmentMethod])
  @@index([productRefId])
  @@map("order_items")
}

model OrderEvent {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  orderItemId String?  @map("order_item_id")
  eventType   String   @map("event_type") // status_change | tracking_added | webhook_received | manual_resync | pod_submit | pod_skip | warning
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  payload     Json?
  userId      String?  @map("user_id")
  source      String   @default("system") // system | admin | webhook | pod
  createdAt   DateTime @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([orderItemId])
  @@map("order_events")
}

// ============================================
// EXPENSE LEDGER
// ============================================

model Expense {
  id           String   @id @default(uuid())
  category     String   // pod_production | image_generation | image_upscale | manual
  userId       String?  @map("user_id")
  orderId      String?  @map("order_id")
  orderItemId  String?  @map("order_item_id")
  generationId String?  @map("generation_id")
  provider     String?  // pictorem | fal | openrouter | manual
  providerRef  String?  @map("provider_ref")
  amount       Decimal  @db.Decimal(12, 6)
  currency     String   @default("USD")
  amountBase   Decimal? @map("amount_base") @db.Decimal(12, 6)
  baseCurrency String?  @map("base_currency")
  fxRate       Decimal? @map("fx_rate") @db.Decimal(12, 6)
  detail       Json?
  note         String?
  source       String   @default("system") // system | admin
  createdBy    String?  @map("created_by")
  dedupeKey    String?  @unique @map("dedupe_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([generationId])
  @@index([category])
  @@map("expenses")
}

model ProviderRate {
  id        String   @id @default(uuid())
  provider  String   // fal
  model     String   // fal-ai/flux/dev | fal-ai/seedvr/upscale/image
  unit      String   // per_image | per_megapixel | per_call
  amount    Decimal  @db.Decimal(12, 6)
  currency  String   @default("USD")
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@unique([provider, model])
  @@map("provider_rates")
}

// ============================================
// APP SETTINGS (runtime key-value flags)
// ============================================

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}

// ============================================
// SYNC LOGS
// ============================================

model SyncLog {
  id                  String    @id @default(uuid())
  type                String // 'cron' | 'manual' | 'webhook'
  status              String // 'running' | 'completed' | 'failed'
  startedAt           DateTime  @map("started_at")
  completedAt         DateTime? @map("completed_at")
  productsChecked     Int?      @map("products_checked")
  productsCreated     Int?      @map("products_created")
  productsUpdated     Int?      @map("products_updated")
  productsDeactivated Int?      @map("products_deactivated")
  errors              Json?
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([type])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("sync_logs")
}
